{
  "area": "llm-output-parser",
  "description": "LLM の自由形式の出力から ToDo と要約を読む parseTodos と parseSummary。前処理として、<think> から </think>(なければ末尾)までと、``` で始まる行を消し、前後の空白を除く",
  "inputSchema": "op: \"todos\" か \"summary\"。text: LLM の出力",
  "expectedSchema": "\"todos\": result に読んだ結果。読めなければ null。読めたら {items: [{task, kind, due}], isComplete}。task は前後の空白を除いた文字列。kind と due は JSON の値が文字列ならその文字列、数などの文字列以外の基本型ならその JSON の表記の文字列(20261102 なら \"20261102\")、null かキーがなければ null。isComplete は、壊れた JSON を飛ばさず、打ち切りもなく、どの要素も捨てなかったときだけ true。\"summary\": summary に整えた要約の文字列。箇条書き(行頭の -、*、・)があればそれだけを「- 」で揃えて改行でつなぎ、なければ空でない行を前後の空白を除いてつなぐ。本文がなければ null",
  "cases": [
    {
      "name": "素直な JSON を読む",
      "input": {
        "op": "todos",
        "text": "{\"items\": [{\"task\": \"牛乳を買う\", \"kind\": \"todo\", \"due\": \"2026-11-02\"}]}"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "牛乳を買う",
              "kind": "todo",
              "due": "2026-11-02"
            }
          ],
          "isComplete": true
        }
      }
    },
    {
      "name": "空の items は読めた結果として扱う",
      "input": {
        "op": "todos",
        "text": "{\"items\": []}"
      },
      "expected": {
        "result": {
          "items": [],
          "isComplete": true
        }
      }
    },
    {
      "name": "包みや余分な記号があっても読む(コードブロックの包み)",
      "input": {
        "op": "todos",
        "text": "```json\n{\"items\": [{\"task\": \"牛乳を買う\", \"kind\": \"todo\", \"due\": \"2026-11-02\"}]}\n```"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "牛乳を買う",
              "kind": "todo",
              "due": "2026-11-02"
            }
          ],
          "isComplete": true
        }
      }
    },
    {
      "name": "包みや余分な記号があっても読む(言語名のないコードブロック)",
      "input": {
        "op": "todos",
        "text": "```\n{\"items\": [{\"task\": \"牛乳を買う\", \"kind\": \"todo\", \"due\": \"2026-11-02\"}]}\n```\n"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "牛乳を買う",
              "kind": "todo",
              "due": "2026-11-02"
            }
          ],
          "isComplete": true
        }
      }
    },
    {
      "name": "包みや余分な記号があっても読む(前後の説明)",
      "input": {
        "op": "todos",
        "text": "抽出結果は次のとおりです。\n{\"items\": [{\"task\": \"牛乳を買う\", \"kind\": \"todo\", \"due\": \"2026-11-02\"}]}\n以上です。"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "牛乳を買う",
              "kind": "todo",
              "due": "2026-11-02"
            }
          ],
          "isComplete": true
        }
      }
    },
    {
      "name": "包みや余分な記号があっても読む(考えの区間の中の JSON は読まない)",
      "input": {
        "op": "todos",
        "text": "<think>{\"items\": []} を出すか考える</think>{\"items\": [{\"task\": \"牛乳を買う\", \"kind\": \"todo\", \"due\": \"2026-11-02\"}]}"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "牛乳を買う",
              "kind": "todo",
              "due": "2026-11-02"
            }
          ],
          "isComplete": true
        }
      }
    },
    {
      "name": "包みや余分な記号があっても読む(末尾のカンマ)",
      "input": {
        "op": "todos",
        "text": "{\"items\": [{\"task\": \"牛乳を買う\", \"kind\": \"todo\", \"due\": \"2026-11-02\"},],}"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "牛乳を買う",
              "kind": "todo",
              "due": "2026-11-02"
            }
          ],
          "isComplete": true
        }
      }
    },
    {
      "name": "包みや余分な記号があっても読む(items のない配列だけの出力)",
      "input": {
        "op": "todos",
        "text": "[{\"task\": \"牛乳を買う\", \"kind\": \"todo\", \"due\": \"2026-11-02\"}]"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "牛乳を買う",
              "kind": "todo",
              "due": "2026-11-02"
            }
          ],
          "isComplete": true
        }
      }
    },
    {
      "name": "本文の中の括弧と引用符で区切りを誤らない",
      "input": {
        "op": "todos",
        "text": "{\"items\": [{\"task\": \"「}]」と \\\"書く\\\"\", \"kind\": \"todo\", \"due\": null}]}"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "「}]」と \"書く\"",
              "kind": "todo",
              "due": null
            }
          ],
          "isComplete": true
        }
      }
    },
    {
      "name": "打ち切られた出力は閉じた要素までを不完全として読む",
      "input": {
        "op": "todos",
        "text": "{\"items\": [{\"task\": \"牛乳を買う\", \"kind\": \"todo\", \"due\": \"2026-11-02\"}, {\"task\": \"途中で切れ"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "牛乳を買う",
              "kind": "todo",
              "due": "2026-11-02"
            }
          ],
          "isComplete": false
        }
      }
    },
    {
      "name": "内容のない要素は捨てて不完全にする",
      "input": {
        "op": "todos",
        "text": "{\"items\": [{\"task\": \"牛乳を買う\", \"kind\": \"todo\", \"due\": \"2026-11-02\"}, {\"kind\": \"todo\"}, {\"task\": \"  \"}, \"文字\"]}"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "牛乳を買う",
              "kind": "todo",
              "due": "2026-11-02"
            }
          ],
          "isComplete": false
        }
      }
    },
    {
      "name": "途中が壊れていても内側の配列が読めれば不完全として読む",
      "input": {
        "op": "todos",
        "text": "{\"items\" [{\"task\": \"牛乳を買う\", \"kind\": \"todo\", \"due\": \"2026-11-02\"}]"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "牛乳を買う",
              "kind": "todo",
              "due": "2026-11-02"
            }
          ],
          "isComplete": false
        }
      }
    },
    {
      "name": "別の形の JSON の後ろにある items を読む",
      "input": {
        "op": "todos",
        "text": "{\"note\": 1} {\"items\": [{\"task\": \"牛乳を買う\", \"kind\": \"todo\", \"due\": \"2026-11-02\"}]}"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "牛乳を買う",
              "kind": "todo",
              "due": "2026-11-02"
            }
          ],
          "isComplete": true
        }
      }
    },
    {
      "name": "読めない出力は null を返す(空)",
      "input": {
        "op": "todos",
        "text": ""
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "読めない出力は null を返す(空白)",
      "input": {
        "op": "todos",
        "text": "   "
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "読めない出力は null を返す(JSON のない文)",
      "input": {
        "op": "todos",
        "text": "該当なし"
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "読めない出力は null を返す(開き括弧だけ)",
      "input": {
        "op": "todos",
        "text": "{"
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "読めない出力は null を返す(値のない items)",
      "input": {
        "op": "todos",
        "text": "{\"items\": "
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "読めない出力は null を返す(配列でない items)",
      "input": {
        "op": "todos",
        "text": "{\"items\": 3}"
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "読めない出力は null を返す(オブジェクトでない要素の配列)",
      "input": {
        "op": "todos",
        "text": "[1, 2]"
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "読めない出力は null を返す(閉じていない考えの区間)",
      "input": {
        "op": "todos",
        "text": "<think>考え中"
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "期限と種類が null や別の型でも読む",
      "input": {
        "op": "todos",
        "text": "{\"items\": [{\"task\": \"作業\", \"kind\": null, \"due\": 20261102}]}"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "作業",
              "kind": null,
              "due": "20261102"
            }
          ],
          "isComplete": true
        }
      }
    },
    {
      "name": "task の前後の空白は除く",
      "input": {
        "op": "todos",
        "text": "{\"items\": [{\"task\": \"  洗濯をする \", \"kind\": \"todo\"}]}"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "洗濯をする",
              "kind": "todo",
              "due": null
            }
          ],
          "isComplete": true
        }
      }
    },
    {
      "name": "不完全な判定は読めた件数と独立している(閉じた出力)",
      "input": {
        "op": "todos",
        "text": "{\"items\": [{\"task\": \"牛乳を買う\", \"kind\": \"todo\", \"due\": \"2026-11-02\"}]}"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "牛乳を買う",
              "kind": "todo",
              "due": "2026-11-02"
            }
          ],
          "isComplete": true
        }
      }
    },
    {
      "name": "不完全な判定は読めた件数と独立している(閉じていない出力)",
      "input": {
        "op": "todos",
        "text": "{\"items\": [{\"task\": \"牛乳を買う\", \"kind\": \"todo\", \"due\": \"2026-11-02\"}"
      },
      "expected": {
        "result": {
          "items": [
            {
              "task": "牛乳を買う",
              "kind": "todo",
              "due": "2026-11-02"
            }
          ],
          "isComplete": false
        }
      }
    },
    {
      "name": "要約は箇条書きだけを残して記号を揃える",
      "input": {
        "op": "summary",
        "text": "以下が要約です。\n\n- 一つ目\n* 二つ目\n・三つ目\n"
      },
      "expected": {
        "summary": "- 一つ目\n- 二つ目\n- 三つ目"
      }
    },
    {
      "name": "箇条書きがなくても本文があれば残す",
      "input": {
        "op": "summary",
        "text": "```\n会議の要約\n```"
      },
      "expected": {
        "summary": "会議の要約"
      }
    },
    {
      "name": "本文のない要約は null を返す(空)",
      "input": {
        "op": "summary",
        "text": ""
      },
      "expected": {
        "summary": null
      }
    },
    {
      "name": "本文のない要約は null を返す(空白と改行)",
      "input": {
        "op": "summary",
        "text": " \n "
      },
      "expected": {
        "summary": null
      }
    },
    {
      "name": "本文のない要約は null を返す(考えの区間だけ)",
      "input": {
        "op": "summary",
        "text": "<think>考え中</think>"
      },
      "expected": {
        "summary": null
      }
    },
    {
      "name": "本文のない要約は null を返す(空のコードブロック)",
      "input": {
        "op": "summary",
        "text": "```\n```"
      },
      "expected": {
        "summary": null
      }
    }
  ]
}

        "embedder": {
          "responses": [
            [
              1,
              0,
              0
            ]
          ]
        },
        "steps": [
          {
            "op": "identify",
            "millis": 3000,
            "samples": 16
          },
          {
            "op": "snapshot",
            "include": [
              "speakers",
              "embedderCalls"
            ]
          }
        ]
      },
      "expected": {
        "steps": [
          {
            "turns": [
              {
                "startedAtMillis": 0,
                "endedAtMillis": 3000,
                "text": "本文",
                "speakerId": null,
                "confidence": null,
                "voice": null
              }
            ]
          },
          {
            "speakers": [],

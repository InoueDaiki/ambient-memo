-- メモから抽出した ToDo。due_date は端末の日付で YYYY-MM-DD。時刻までは抽出しない
-- kind と status は SqliteMemoRepository の対応表で読み書きする
-- completed_at_ms は完了した時刻。completed_from_status は完了の前の status で、取り消しのときに戻す
CREATE TABLE todo (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  memo_id INTEGER NOT NULL REFERENCES memo (id),
  task TEXT NOT NULL,
  kind TEXT NOT NULL,
  due_date TEXT,
  status TEXT NOT NULL,
  created_at_ms INTEGER NOT NULL,
  completed_at_ms INTEGER,
  completed_from_status TEXT
);

CREATE INDEX todo_memo ON todo (memo_id);

insert:
INSERT INTO todo (memo_id, task, kind, due_date, status, created_at_ms)
VALUES (?, ?, ?, ?, ?, ?);

listByMemo:
SELECT *
FROM todo
WHERE memo_id = :memoId
ORDER BY id;

listByPriority:
SELECT *
FROM todo
ORDER BY status = 'done', due_date IS NULL, due_date, created_at_ms DESC, id
LIMIT :limit;

statusOf:
SELECT status
FROM todo
WHERE id = :id;

complete:
UPDATE todo
SET completed_from_status = status, status = 'done', completed_at_ms = :completedAtMs
WHERE id = :id;

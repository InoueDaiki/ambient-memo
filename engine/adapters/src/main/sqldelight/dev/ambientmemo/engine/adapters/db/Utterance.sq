-- 文字起こしの最小単位。時刻は UNIX エポックからのミリ秒
-- confidence は文字起こしの信頼度、speaker_confidence は話者のコサイン類似度。speaker_id が NULL なら話者は不明
CREATE TABLE utterance (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  started_at_ms INTEGER NOT NULL,
  ended_at_ms INTEGER NOT NULL,
  body TEXT NOT NULL,
  confidence REAL,
  created_at_ms INTEGER NOT NULL,
  organized_at_ms INTEGER,
  speaker_id INTEGER REFERENCES speaker (id),
  speaker_confidence REAL,
  CHECK (ended_at_ms >= started_at_ms),
  CHECK (confidence IS NULL OR confidence BETWEEN 0.0 AND 1.0)
);

CREATE INDEX utterance_started_at ON utterance (started_at_ms);

-- 整理ジョブが未処理の発話だけを読む。organized_at_ms が NULL の行が未処理
CREATE INDEX utterance_unorganized ON utterance (started_at_ms, id) WHERE organized_at_ms IS NULL;

CREATE INDEX utterance_speaker ON utterance (speaker_id);

insert:
INSERT INTO utterance (started_at_ms, ended_at_ms, body, confidence, created_at_ms, speaker_id, speaker_confidence)
VALUES (?, ?, ?, ?, ?, ?, ?);

lastInsertedId:
SELECT last_insert_rowid();

listOverlapping:
SELECT *
FROM utterance
WHERE started_at_ms < :toMillis AND ended_at_ms > :fromMillis
ORDER BY started_at_ms, id;

listRecent:
SELECT *
FROM utterance
ORDER BY started_at_ms DESC, id DESC
LIMIT :limit;

listByMemo:
SELECT utterance.*
FROM utterance
JOIN memo_utterance ON memo_utterance.utterance_id = utterance.id
WHERE memo_utterance.memo_id = :memoId
ORDER BY utterance.started_at_ms, utterance.id;

listUnorganized:
SELECT *
FROM utterance
WHERE organized_at_ms IS NULL
ORDER BY started_at_ms, id;

findById:
SELECT *
FROM utterance
WHERE id = :id;

-- 手で直した話者。類似度はもとの判定の値なので残さない
setSpeaker:
UPDATE utterance
SET speaker_id = :speakerId, speaker_confidence = NULL
WHERE id = :id;

moveSpeaker:
UPDATE utterance
SET speaker_id = :intoId, speaker_confidence = NULL
WHERE speaker_id = :fromId;

clearSpeakers:
UPDATE utterance
SET speaker_id = NULL, speaker_confidence = NULL;

countBySpeaker:
SELECT speaker_id, count(*)
FROM utterance
WHERE speaker_id IS NOT NULL
GROUP BY speaker_id;

countUnorganized:
SELECT count(*)
FROM utterance
WHERE id = :id AND organized_at_ms IS NULL;

markOrganized:
UPDATE utterance
SET organized_at_ms = :organizedAtMillis
WHERE id = :id AND organized_at_ms IS NULL;
